@model BabyCiao.Controllers.DataAnalysisViewModel

<div id="app">
    <h2 class="text-center">各項總數分析圖</h2>
    <div id="chart" style="width: 600px; height: 600px;"></div>
</div>

<div id="newapp">
    <h2 class="text-center">會員分布圖</h2>
    <div id="newchart" style="width: 1500px; height: 600px;"></div>
</div>

<div id="competitionapp">
    <h2 class="text-center">競賽投票分析圖</h2>
    <div id="competitionchart" style="width: 1500px; height: 600px;"></div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/vue@2"></script>
    <script src="https://cdn.jsdelivr.net/npm/echarts/dist/echarts.min.js"></script>

    <script>
        new Vue({
            el: '#app',
            data: {
                parentTotalCount: @Model.ParentTotalCount,
                nannyTotalCount: @Model.NannyTotalCount
                    },
            mounted() {
                this.drawChart();
            },
            methods: {
                drawChart() {
                    var chartDom = document.getElementById('chart');
                    var myChart = echarts.init(chartDom);
                    var option = {
                        tooltip: {
                            trigger: 'axis',
                            axisPointer: {
                                type: 'shadow'
                            }
                        },
                        legend: {
                            data: ['帳號數量', '聯絡簿數量'],
                            textStyle: {
                                fontSize: 18,
                                color: 'black'
                            }
                        },
                        grid: {
                            left: '13%',
                            right: '14%',
                            bottom: '13%',
                            containLabel: true
                        },
                        xAxis: {
                            type: 'category',
                            data: ['各數據分析'],
                            axisLabel: {
                                fontSize: 24,
                                color: 'black'
                            }
                        },
                        yAxis: {
                            type: 'value',
                            axisLabel: {
                                fontSize: 16,
                                color: 'black'
                            }
                        },
                        series: [
                            {
                                name: '聯絡簿數量',
                                type: 'bar',
                                data: [this.nannyTotalCount],
                                itemStyle: {
                                    color: 'rgba(255, 99, 132, 0.5)'
                                },
                                label: {
                                    show: true,
                                    position: 'top',
                                    fontSize: 16,
                                    color: 'black'
                                }
                            },
                            {
                                name: '帳號數量',
                                type: 'bar',
                                data: [this.parentTotalCount],
                                itemStyle: {
                                    color: 'rgba(54, 162, 235, 0.5)'
                                },
                                label: {
                                    show: true,
                                    position: 'top',
                                    fontSize: 16,
                                    color: 'black'
                                }
                            }
                        ]
                    };

                    option && myChart.setOption(option);
                }
            }
        });

        new Vue({
            el: '#newapp',
            data: {
                addressTotalCount: @Html.Raw(Json.Serialize(Model.AddressTotalCount))
                    },
            mounted() {
                this.drawNewChart();
            },
            methods: {
                drawNewChart() {
                    if (!Array.isArray(this.addressTotalCount)) {
                        console.error("addressTotalCount 錯誤");
                        return;
                    }

                    var addresses = this.addressTotalCount.map(item => item.address);
                    var counts = this.addressTotalCount.map(item => item.count);

                    var chartDom = document.getElementById('newchart');
                    var myChart = echarts.init(chartDom);
                    var option = {
                        tooltip: {
                            trigger: 'axis',
                            axisPointer: {
                                type: 'shadow'
                            }
                        },
                        legend: {
                            data: ['會員總數'],
                            textStyle: {
                                fontSize: 18,
                                color: 'black'
                            }
                        },
                        grid: {
                            left: '10%',
                            right: '10%',
                            bottom: '15%',
                            containLabel: true
                        },
                        xAxis: {
                            type: 'category',
                            data: addresses,
                            axisLabel: {
                                fontSize: 14,
                                color: 'black',
                                rotate: 45,
                                interval: 0
                            }
                        },
                        yAxis: {
                            type: 'value',
                            axisLabel: {
                                fontSize: 16,
                                color: 'black'
                            }
                        },
                        series: [
                            {
                                name: '會員總數',
                                type: 'bar',
                                data: counts,
                                itemStyle: {
                                    color: 'rgba(75, 192, 192, 0.5)'
                                },
                                label: {
                                    show: true,
                                    position: 'top',
                                    fontSize: 16,
                                    color: 'black'
                                }
                            }
                        ]
                    };

                    option && myChart.setOption(option);
                }
            }
        });

        new Vue({
            el: '#competitionapp',
            data: {
                competitionNameCount: @Html.Raw(Json.Serialize(Model.CompetitionNameCount))
                    },
            mounted() {
                this.drawCompetitionChart();
            },
            methods: {
                drawCompetitionChart() {
                    if (!Array.isArray(this.competitionNameCount)) {
                        console.error("competitionNameCount 錯誤");
                        return;
                    }

                    // 排序 CompetitionName，以確保 X 軸順序
                    this.competitionNameCount.sort((a, b) => a.competitionName.localeCompare(b.competitionName));

                    var competitionNames = this.competitionNameCount.map(item => item.competitionName);
                    var counts = this.competitionNameCount.map(item => item.count);

                    var chartDom = document.getElementById('competitionchart');
                    var myChart = echarts.init(chartDom);
                    var option = {
                        tooltip: {
                            trigger: 'axis',
                            axisPointer: {
                                type: 'line'
                            }
                        },
                        legend: {
                            data: ['競賽投票數量'],
                            textStyle: {
                                fontSize: 18,
                                color: 'black'
                            }
                        },
                        grid: {
                            left: '10%',
                            right: '10%',
                            bottom: '15%',
                            containLabel: true
                        },
                        xAxis: {
                            type: 'category',
                            data: competitionNames,
                            axisLabel: {
                                fontSize: 14,
                                color: 'black',
                                rotate: 45,
                                interval: 0
                            }
                        },
                        yAxis: {
                            type: 'value',
                            axisLabel: {
                                fontSize: 16,
                                color: 'black'
                            },
                            minInterval: 5 // 設置 Y 軸的最小刻度為 5
                        },
                        series: [
                            {
                                name: '競賽投票數量',
                                type: 'line',
                                data: counts,
                                itemStyle: {
                                    color: 'rgba(153, 102, 255, 0.5)'
                                },
                                label: {
                                    show: true,
                                    position: 'top',
                                    fontSize: 16,
                                    color: 'black'
                                }
                            }
                        ]
                    };

                    option && myChart.setOption(option);
                }
            }
        });
    </script>
}
