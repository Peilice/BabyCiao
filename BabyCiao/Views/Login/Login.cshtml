@{
    Layout = "_Layout";
    ViewData["Title"] = "登入";
}

<div class="login-container">
    <div class="login-box">
        <div class="login-avatar">
            <img src="/images/登入.png" alt="Avatar" />
        </div>
        <form id="loginForm">
            <div class="input-group">
                <label for="account">帳號</label>
                <input type="text" id="account" name="account" required autocomplete="off" />
            </div>
            <div class="input-group">
                <label for="password">密碼</label>
                <input type="password" id="password" name="Password" required autocomplete="off" />
            </div>
            
            <button type="submit" class="btn-login">登入</button>
        </form>
        <div id="message" class="message"></div>
    </div>
</div>

@section Scripts {
    @* <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.1/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/axios/1.7.2/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.3/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.12/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://unpkg.com/vue@3.4.31/dist/vue.global.prod.js"></script> *@
    <script>
        document.getElementById('loginForm').addEventListener('submit', async function (event) {
            event.preventDefault();

            const account = document.getElementById('account').value;
            const password = document.getElementById('password').value;
            const messageDiv = document.getElementById('message');

            try {
                const response = await fetch('https://localhost:7292/api/UserAccount/login', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ account, password }),
                });

                const data = await response.json();

                if (response.ok) {
                    messageDiv.textContent = data.message;
                    messageDiv.className = 'message success';
                    localStorage.setItem('token', data.token); // 保存 token 到 localStorage
                    localStorage.setItem('account', account); // 保存 account 到 localStorage
                    localStorage.setItem('permissions', data.permissions);

                    sessionStorage.setItem("username", account);


                    document.cookie = `token=${data.token}; path=/; domain=localhost`;
                    document.cookie = `account=${account}; path=/; domain=localhost`;
                    document.cookie = `permissions=${data.permissions}; path=/; domain=localhost`;

                    // 3秒後跳轉到指定的URL
                    setTimeout(() => {
                        window.location.href = 'https://localhost:7000/';
                    }, 3000);
                } else {
                    messageDiv.textContent = data.message;
                    messageDiv.className = 'message error';
                    console.error('登入失敗', data);
                }
            } catch (error) {
                messageDiv.textContent = '登入失敗，請稍後再試';
                messageDiv.className = 'message error';
                console.error('登入失敗', error);
            }
        });
    </script>
}


<style>
    .login-container {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        background-image: url('/images/giftly.png');
        /* background-size: cover;
        background-position: center;
        background-blend-mode: overlay; */
        /* background: linear-gradient(135deg, #ff9966, #ff5e62); */
    }


    .login-box {
        width: 450px;
        padding: 60px;
        background: linear-gradient(135deg, #ff9966, #00AEAE);
        backdrop-filter: blur(10px);
        border-radius: 10px;
        box-shadow: 0 0 30px rgba(0, 0, 0, 0.2);
        text-align: center;
    }

    .login-avatar {
        margin-bottom: 20px;
    }

        .login-avatar img {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background-color: rgba(255, 255, 255, 0.2);
        }

    .input-group {
        margin-bottom: 20px;
        text-align: left;
    }

        .input-group label {
            display: block;
            margin-bottom: 5px;
            color: black;
        }

        .input-group input {
            width: 100%;
            padding: 10px;
            border: none;
            border-radius: 5px;
            background: rgba(255, 255, 255, 0.2);
            color: black;
            font-size: 16px;
        }

            .input-group input::placeholder {
                color: rgba(255, 255, 255, 0.7);
            }

    .login-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        color: white;
        font-size: 14px;
    }

        .login-footer a {
            color: #ffd1d1;
            text-decoration: none;
        }

    .btn-login {
        width: 100%;
        padding: 10px;
        background: #e91e63;
        color: white;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        font-size: 16px;
    }

        .btn-login:hover {
            background: #d81b60;
        }

    .message {
        margin-top: 20px;
        padding: 10px;
        border-radius: 5px;
        text-align: center;
    }

        .message.success {
            background-color: #4caf50;
            color: white;
        }

        .message.error {
            background-color: #f44336;
            color: white;
        }
</style>