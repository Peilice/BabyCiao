    </div>


    @section Scripts {
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/axios/1.7.2/axios.min.js" integrity="sha512-JSCFHhKDilTRRXe9ak/FJ28dcpOJxzQaCd3Xg8MyF6XFjODhy/YMCM8HW0TFDckNHWUewW+kfvhin43hKtJxAw==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
        <script>

            const useToken = localStorage.getItem("token");
            const headers = {
                'Authorization': `Bearer ${useToken}`,
            };
            const apps = Vue.createApp({
                data() {
                    return {
                        resume: {},
                        resumes: [],
                        username: "",
                        nickname: "",
                        nannyAccountUserAccount: "",
                        city: "",
                        district: "",
                        introduction: "",
                        typeOfDaycare: "",
                        serviceType: 0,
                        serviceItems: "",
                        quasiPublicChildcare: false,
                        childcareAvailableUnder2: 1,
                        childcareAvailableOver2: 1,
                        language: "",
                        serviceCenter: "",
                        professionalPortrait: "",
                        displayControl: false,
                        checkOtherTypeOfDaycare: false,
                        showOtherTypeOfDaycare: "",
                        checkOtherServiceItems: false,
                        showOtherServiceItems: "",
                        checkOtherLanguage: false,
                        showOtherLanguage: "",
                        serviceTypes: [],
                        otherServiceType: 0,
                        typeOfDaycare: [],
                        typeOfDaycareOtherText: '',
                        showOtherTypeOfDaycare: false,
                        serviceItems: [],
                        serviceItemsOtherText: '',
                        showOtherServiceItems: false,
                        language: [],
                        languageOtherText: '',
                        showOtherLanguage: false,
                        reviews: [],
                        startIndex: 0,
                        itemsPerPage: 3
                    }
                },

                computed: {
                    selectedLanguageString() {
                        // 將選中的語言陣列轉換成以逗號分隔的字串
                        return this.language.join('、');
                    },

                    selectedserviceItemsString() {
                        return this.serviceItems.join('、');
                    },
                    selectedtypeOfDaycareString() {
                        return this.typeOfDaycare.join('、');
                    },
                    paginatedResumes() {
                        return this.resumes.slice(this.startIndex, this.startIndex + this.itemsPerPage);
                    }

                },
                methods: {
                    getUserName: function () {
                        axios.get('https://localhost:7292/api/NannyResumes/GetUserName_NannyResumes', { headers })
                            .then(result => {
                                this.username = result.data;
                                $('#createModel').modal('show');
                            })
                            .catch(err => {
                                console.error(err);
                            });
                    },
                    prevPage() {
                        if (this.startIndex > 0) {
                            this.startIndex -= this.itemsPerPage;
                        }
                    },
                    nextPage() {
                        if (this.startIndex + this.itemsPerPage < this.resumes.length) {
                            this.startIndex += this.itemsPerPage;
                        }
                    },
                    checkOtherTypeOfDaycare() {
                        this.showOtherTypeOfDaycare = this.typeOfDaycare.includes('其他');
                    },
                    checkOtherServiceItems() {
                        this.showOtherServiceItems = this.serviceItems.includes('其他');
                    },
                    checkOtherLanguage() {
                        this.showOtherLanguage = this.language.includes('其他');
                    },
                    create: function (e) {
                        //alert("AAA")
                        e.preventDefault();
                        let _this = this;


                        var request = {
                            // 其他表單欄位
                            language: _this.selectedLanguageString, // 使用計算屬性來生成字串
                            // 其他表單欄位
                            serviceItems: _this.selectedserviceItemsString,
                            typeOfDaycare: _this.selectedtypeOfDaycareString,

                        };

                        console.log(request);


                        request.nannyAccountUserAccount = _this.username;
                        request.nickname = _this.nickname;
                        //request.serviceType = _this.serviceType;
                        request.city = _this.city;
                        request.district = _this.district;
                        //request.typeOfDaycare = _this.typeOfDaycare;
                        request.introduction = _this.introduction;
                        //request.serviceItems = _this.serviceItems;
                        // request. = _this.quasiPublicChildcare;
                        request.childcareAvailableUnder2 = _this.childcareAvailableUnder2;
                        request.childcareAvailableOver2 = _this.childcareAvailableOver2;
                        //request.language = _this.language;
                        request.serviceCenter = _this.serviceCenter;
                        request.professionalPortrait = _this.professionalPortrait.name;
                        request.displayControl = true;
                        axios.post('https://localhost:7292/api/NannyResumes/SubmitResume', request, { headers })
                            .then(result => {
                                Swal.fire({
                                    position: 'center',
                                    icon: 'success',
                                    title: '履歷提交成功',
                                    showConfirmButton: false,
                                    timer: 1500,
                                }).then(() => {
                                    _this.getNannyResumes();
                                    $('#createmodel').modal('hide');
                                });
                            })
                            .catch(err => {
                                console.error(err);
                                Swal.fire({
                                    position: 'center',
                                    icon: 'error',
                                    title: '發生錯誤',
                                    showConfirmButton: false,
                                    timer: 1500
                                });
                            });
                    },

                    showDetails(id) {
                        axios.get(`https://localhost:7292/api/NannyResumes/GetNannyResume/${id}`)
                            .then(response => {
                                this.resume = response.data;
                                $('#nannyResumesModal').modal('show'); // 打開詳細資訊視窗
                            })
                            .catch(error => {
                                console.error("Error fetching resume details:", error);
                            });
                    },

                    checkForm: function () {
                        let forms = document.querySelectorAll('.needs-validation');
                        Array.prototype.slice.call(forms)
                            .forEach(function (form) {
                                form.addEventListener('submit', function (event) {
                                    if (!form.checkValidity()) {
                                        event.preventDefault();
                                        event.stopPropagation();
                                    } else {
                                        this.create(event);
                                    }
                                    form.classList.add('was-validated');
                                }, false);
                            });
                    },
                    onFileChange: function (previewTarget, fileVariable, event) {
                        const fileInput = event.target;
                        if (fileInput.files && fileInput.files[0]) {
                            const file = fileInput.files[0];
                            this[fileVariable] = file;
                            const reader = new FileReader();
                            reader.onload = (e) => {
                                this[previewTarget] = e.target.result;
                            };
                            reader.readAsDataURL(file);
                        }
                    },
                    getNannyResumes: function () {
                        let_this = this;
                        axios.get('@Utility.SD.localHost_API/api/NannyResumes/GetFullinformation', { headers })
                            .then(result => {
                                //console.log(result.data); // 確認資料結構
                                let_this.resumes = result.data;
                            })
                            .catch(err => {
                                console.error(err);
                            });
                    },
                    getPhotoUrl(photo) {
                        return photo != null ? `https://localhost:7000/NannnyAndPerant/nannyreume/${photo}` : `https://localhost:7000/image/noimage.jpg`;
                    },
                    fetchReviews() {
                        $.ajax({
                            url: "https://localhost:7292/api/UserEvaluations",
                            type: "GET",
                            dataType: "json",
                            success: (data) => {
                                console.log("Fetched Reviews:", data); // Log the data
                                this.reviews = data;
                            },
                            error: (xhr, status, error) => {
                                console.error("Error fetching reviews:", error);
                            }
                        });
                    },
                    enter(nannyAccountUserAccount) {
                        sessionStorage.setItem("nannyAccountUserAccount", nannyAccountUserAccount);
                        window.location.href = `https://localhost:7231/Machplateform/Home/NannyApply`;
                    },
                },

                mounted: function () {
                    let _this = this;
                    //this.getNannyResumes();
                    _this.getNannyResumes();
                    this.fetchReviews();
                }
            });

            apps.mount('#nannyIndex');


        document.addEventListener('DOMContentLoaded', () => {
            const carousel = document.getElementById('carousel');
            const prevButton = document.getElementById('prev');
            const nextButton = document.getElementById('next');
            const scrollStep = 300; // 每次滾動的步伐大小（像素）
            let autoScrollInterval;

            // 自動輪播功能
            function startAutoScroll() {
                autoScrollInterval = setInterval(() => {
                    if (carousel.scrollLeft + carousel.clientWidth >= carousel.scrollWidth) {
                        carousel.scrollLeft = 0;
                    } else {
                        carousel.scrollLeft += scrollStep;
                    }
                }, 3000); // 每3秒滾動一次
            }

            // 停止自動輪播
            function stopAutoScroll() {
                clearInterval(autoScrollInterval);
            }

            // 向左滾動
            function scrollLeft() {
                carousel.scrollLeft -= scrollStep;
            }

            // 向右滾動
            function scrollRight() {
                carousel.scrollLeft += scrollStep;
            }

            prevButton.addEventListener('click', () => {
                stopAutoScroll();
                scrollLeft();
                startAutoScroll();
            });

            nextButton.addEventListener('click', () => {
                stopAutoScroll();
                scrollRight();
                startAutoScroll();
            });

            carousel.addEventListener('mouseover', stopAutoScroll);
            carousel.addEventListener('mouseout', startAutoScroll);

            startAutoScroll(); // 開始自動輪播
        });

        </script>
    }
