                                    </div>
                                    <div class="invalid-feedback">請填寫語言.</div>
                                </div>
                                <div class="form-group">
                                    <label for="serviceCenter">服務中心:</label>
                                    <input v-model="serviceCenter" id="serviceCenter" class="form-control" required />
