@section Styles {
        <title>保母委託單</title>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    }

    <!-- breadcrumb start -->
    <div id="nannyIndex">
        <div class="px-3 py-2 mb-2">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 bg-transparent p-2 text-dark bg-opacity-10">
                    <li class="breadcrumb-item"><a class="text-decoration-none" href="./MatchIndex.html">首頁</a></li>
                    <li class="breadcrumb-item active" aria-current="page">保母平台</li>
                </ol>
            </nav>
@*             <div class="row" style="width:40%;margin-left:auto;margin-left:10">
            <input type="text" class="form-control" v-model="searchQuery" placeholder="輸入關鍵字搜尋" />
             </div>
 *@        
            <div class="row" style="width:15%;margin-left:auto;margin-right:0">
                <button type="button" class="btn btn-primary mb-2" data-bs-toggle="modal" data-bs-target="#createmodel" v-on:click="getUserName()">
                    新增保母委託單
                </button>
                <a asp-area="Machplateform" asp-controller="Home" asp-action="NannyApply" class="btn btn-primary mb-2">
                    加入貝比巧遇
                </a>
            </div>

            <!-- breadcrumb end -->

            <h2>保母委託單</h2>
        <div id="nannyIndex" class="container">
                <div class="row">
                    <div class="col-12 mb-4">
                        <div class="row">
                            <div class="col-4 mb-2" v-for="item in resumes" :key="item.id">
                                <div class="card">
                                    <img :src="getPhotoUrl(item.professionalPortrait)" class="card-img-top" style="height: 380px;">
                                    <div class="card-body">
                                        <div class="down-content">
                                            <h5>名字：{{ item.nickname }}</h5>
                                            <h5>地區：{{ item.city }}, {{ item.district }}</h5>
                                            <h5>服務方式：{{ item.typeOfDaycare }}</h5>
                                            <div class="d-flex justify-content-center">
                                                <button class="btn btn-outline-success" v-on:click="showDetails(item.id)">詳細資訊</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 詳細資訊模態框 -->
                <div class="modal fade" id="nannyResumesModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="exampleModalLabel">{{ resumes.nickname }}</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <div class="swiper-container pb-2">
                                    <div class="swiper-wrapper">
                                        <div class="swiper-slide" v-for="professionalPortrait in resume.professionalPortraits" :key="professionalPortrait.id">
                                            <img :src="getPhotoUrl(professionalPortrait)" :alt="resume.nickname">
                                        </div>
                                    </div>
                                </div>
                                <p>名字：{{ resume.nickname }}</p>
                                <p>服務方式：{{ resume.typeOfDaycare }}</p>
                                <p>服務項目：{{ resume.serviceItems }}</p>
                                <p>語言：{{ resume.language }}</p>
                                <p>可收托2歲以上孩童數：{{ resume.childcareAvailableOver2 }}</p>
                                <p>可收托2歲以下孩童數：{{ resume.childcareAvailableUnder2 }}</p>
                                <p>自我介紹：{{ resume.introduction }}</p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">關閉</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 新增收託書模態框 -->
                <div class="modal fade" data-bs-backdrop="static" id="createmodel" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="exampleModalLabel">新增收託書</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <form class="needs-validation" v-on:submit.prevent="create" novalidate>
                                    <div class="mb-3 has-validation">
                                        <label for="nannyAccountUserAccount">帳號</label>
                                        <div class="invalid-feedback">此欄位必填!</div>
                                        <input type="text" class="form-control" id="nannyAccountUserAccount" v-model="username" readonly />
                                    </div>
                                    <div class="form-group mb-3">
                                        <label for="professionalPortrait">個人照:</label>
                                        <input type="file" class="form-control" id="professionalPortrait" v-on:change="(event) => onFileChange('professionalPortraitPreview', 'professionalPortrait', event)">
                                        <div class="invalid-feedback">請放上個人照片</div>
                                    </div>
                                    <div class="form-group">
                                        <label for="nickname">暱稱:</label>
                                        <input v-model="nickname" id="nickname" class="form-control" />
                                    </div>
                                    <div class="form-group">
                                        <label for="city" class="form-label">縣市</label>
                                        <select v-model="city" class="form-select" required>
                                            <option selected disabled value="">請選擇</option>
                                            <option value="基隆市">基隆市</option>
                                            <option value="臺北市">臺北市</option>
                                            <option value="新北市">新北市</option>
                                            <option value="桃園市">桃園市</option>
                                            <option value="新竹縣">新竹縣</option>
                                            <option value="新竹市">新竹市</option>
                                            <option value="宜蘭縣">宜蘭縣</option>
                                            <option value="臺中市">臺中市</option>
                                            <option value="苗栗縣">苗栗縣</option>
                                            <option value="彰化縣">彰化縣</option>
                                            <option value="南投縣">南投縣</option>
                                            <option value="雲林縣">雲林縣</option>
                                            <option value="嘉義縣">嘉義縣</option>
                                            <option value="嘉義市">嘉義市</option>
                                            <option value="臺南市">臺南市</option>
                                            <option value="高雄市">高雄市</option>
                                            <option value="屏東縣">屏東縣</option>
                                            <option value="花蓮縣">花蓮縣</option>
                                            <option value="臺東縣">臺東縣</option>
                                            <option value="澎湖縣">澎湖縣</option>
                                            <option value="金門縣">金門縣</option>
                                        </select>
                                        <div class="invalid-feedback">此欄位必填!</div>
                                    </div>
                                    <div class="form-group">
                                        <label for="district">區域:</label>
                                        <input v-model="district" id="district" class="form-control" required />
                                        <div class="invalid-feedback">此欄位必填!</div>
                                    </div>
                                    <div class="form-group">
                                        <label for="introduction">介紹:</label>
                                        <textarea v-model="introduction" id="introduction" class="form-control"></textarea>
                                        <div class="invalid-feedback">此欄位必填!</div>
                                    </div>
                                    <div class="form-group">
                                        <label for="serviceType" class="form-label">服務方式</label>
                                        <div>
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" v-model="serviceType" value=0>
                                                <label class="form-check-label">到宅托育</label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" v-model="serviceType" value=1>
                                                <label class="form-check-label">居家托育</label>
                                            </div>
                                        </div></><div class="invalid-feedback">此欄位必填!</div>
                                    </div>
                                    <div class="form-group">
                                        <label for="typeOfDaycare" class="form-label">托育時段</label>
                                        <div>
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" v-model="typeOfDaycare" value="半日托育">
                                                <label class="form-check-label">半日托育</label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" v-model="typeOfDaycare" value="半日托育(平日)">
                                                <label class="form-check-label">半日托育(平日)</label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" v-model="typeOfDaycare" value="全日托育">
                                                <label class="form-check-label">全日托育</label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" v-model="typeOfDaycare" value="臨時托育(平日)">
                                                <label class="form-check-label">臨時托育(平日)</label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" v-model="typeOfDaycare" value="臨時托育(假日)">
                                                <label class="form-check-label">臨時托育(假日)</label>
                                            </div>
                                        </div>
                                        <div class="invalid-feedback">此欄位必填!</div>
                                    </div>

                                    <div class="form-group">
                                        <label for="serviceItems" class="form-label">服務項目:</label>
                                        <div>
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" v-model="serviceItems" value="料理服務">
                                                <label class="form-check-label">料理服務</label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" v-model="serviceItems" value="接送服務">
                                                <label class="form-check-label">接送服務</label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" v-model="serviceItems" value="家教服務">
                                                <label class="form-check-label">家教服務</label>
                                            </div>
                                        </div>
                                        <div class="invalid-feedback">此欄位必填!</div>
                                    </div>

                                    <div class="form-group">
                                        <label for="quasiPublicChildcare">可公托:</label>
                                        <input type="checkbox" v-model="quasiPublicChildcare" id="quasiPublicChildcare" />
                                    </div>
                                    <div class="form-group">
                                        <label for="childcareAvailableUnder2">可收托2歲以下孩童數:</label>
                                        <select v-model="childcareAvailableUnder2" id="childcareAvailableUnder2" class="form-control" required>
                                            <option value=1>一位</option>
                                            <option value=2>二位</option>
                                            <option value=3>三位</option>
                                            <option value=4>四位</option>
                                        </select>
                                        <div class="invalid-feedback">此欄位必填!</div>
                                    </div>
                                    <div class="form-group">
                                        <label for="childcareAvailableOver2">可收托2歲以上孩童數:</label>
                                        <select v-model="childcareAvailableOver2" id="childcareAvailableOver2" class="form-control" required>
                                            <option value=1>一位</option>
                                            <option value=2>二位</option>
                                            <option value=3>三位</option>
                                            <option value=4>四位</option>
                                        </select>
                                        <div class="invalid-feedback">此欄位必填!</div>
                                    </div>
                                    <div class="form-group">
                                        <label for="language">語言:</label>
                                        <div>
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" v-model="language" value="中文">
                                                <label class="form-check-label">中文</label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" v-model="language" value="英文">
                                                <label class="form-check-label">英文</label>
                                            </div>

                                        </div>
                                        <div class="invalid-feedback">請填寫語言.</div>
                                    </div>
                                    <div class="form-group">
                                        <label for="serviceCenter">服務中心:</label>
                                        <input v-model="serviceCenter" id="serviceCenter" class="form-control" required />
                                        <div class="invalid-feedback">請填寫此欄位</div>
                                    </div>
                                    <button type="submit" class="btn btn-primary">送出</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

        @section Scripts {
            <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
            <script src="https://cdnjs.cloudflare.com/ajax/libs/axios/1.7.2/axios.min.js" integrity="sha512-JSCFHhKDilTRRXe9ak/FJ28dcpOJxzQaCd3Xg8MyF6XFjODhy/YMCM8HW0TFDckNHWUewW+kfvhin43hKtJxAw==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
            <script>
                const useToken = localStorage.getItem("token");
                const headers = {
                    'Authorization': `Bearer ${useToken}`,
                };
                const apps = Vue.createApp({
                    data() {
                        return {
                            resume: {},
                            resumes: [],
                            username: "",
                            nickname: "",
                            nannyAccountUserAccount: "",
                            city: "",
                            district: "",
                            introduction: "",
                            typeOfDaycare: "",
                            serviceType: 0,
                            serviceItems: "",
                            quasiPublicChildcare: false,
                            childcareAvailableUnder2: 1,
                            childcareAvailableOver2: 1,
                            language: "",
                            serviceCenter: "",
                            professionalPortrait: "",
                            displayControl: false,
                            checkOtherTypeOfDaycare: false,
                            showOtherTypeOfDaycare: "",
                            checkOtherServiceItems: false,
                            showOtherServiceItems: "",
                            checkOtherLanguage: false,
                            showOtherLanguage: "",
                            serviceTypes: [],
                            otherServiceType: 0,
                            typeOfDaycare: [],
                            typeOfDaycareOtherText: '',
                            showOtherTypeOfDaycare: false,
                            serviceItems: [],
                            serviceItemsOtherText: '',
                            showOtherServiceItems: false,
                            language: [],
                            languageOtherText: '',
                            showOtherLanguage: false,
                        }
                    },
                    computed: {
                        selectedLanguageString() {
                            // 將選中的語言陣列轉換成以逗號分隔的字串
                            return this.language.join('、');
                        },

                        selectedserviceItemsString() {
                            return this.serviceItems.join('、');
                        },
                        selectedtypeOfDaycareString() {
                            return this.typeOfDaycare.join('、');
                        }

                    },
                    methods: {
                        getUserName: function () {
                            axios.get('https://localhost:7292/api/NannyResumes/GetUserName_NannyResumes', { headers })
                                .then(result => {
                                    this.username = result.data;
                                    $('#createModel').modal('show');
                                })
                                .catch(err => {
                                    console.error(err);
                                });
                        },
                        checkOtherTypeOfDaycare() {
                            this.showOtherTypeOfDaycare = this.typeOfDaycare.includes('其他');
                        },
                        checkOtherServiceItems() {
                            this.showOtherServiceItems = this.serviceItems.includes('其他');
                        },
                        checkOtherLanguage() {
                            this.showOtherLanguage = this.language.includes('其他');
                        },
                        create: function (e) {
                            //alert("AAA")
                            e.preventDefault();
                            let _this = this;


                            var request = {
                                // 其他表單欄位
                                language: _this.selectedLanguageString, // 使用計算屬性來生成字串
                                // 其他表單欄位
                                serviceItems: _this.selectedserviceItemsString,
                                typeOfDaycare: _this.selectedtypeOfDaycareString,

                            };

                            console.log(request);


                            request.nannyAccountUserAccount = _this.username;
                            request.nickname = _this.nickname;
                            //request.serviceType = _this.serviceType;
                            request.city = _this.city;
                            request.district = _this.district;
                            //request.typeOfDaycare = _this.typeOfDaycare;
                            request.introduction = _this.introduction;
                            //request.serviceItems = _this.serviceItems;
                            // request. = _this.quasiPublicChildcare;
                            request.childcareAvailableUnder2 = _this.childcareAvailableUnder2;
                            request.childcareAvailableOver2 = _this.childcareAvailableOver2;
                            //request.language = _this.language;
                            request.serviceCenter = _this.serviceCenter;
                            request.professionalPortrait = _this.professionalPortrait.name;
                            request.displayControl = true;
                            axios.post('https://localhost:7292/api/NannyResumes/SubmitResume', request, { headers })
                                .then(result => {
                                    Swal.fire({
                                        position: 'center',
                                        icon: 'success',
                                        title: '履歷提交成功',
                                        showConfirmButton: false,
                                        timer: 1500,
                                    }).then(() => {
                                        _this.getNannyResumes();
                                        $('#createmodel').modal('hide');
                                    });
                                })
                                .catch(err => {
                                    console.error(err);
                                    Swal.fire({
                                        position: 'center',
                                        icon: 'error',
                                        title: '發生錯誤',
                                        showConfirmButton: false,
                                        timer: 1500
                                    });
                                });
                        },

                        showDetails(id) {
                            axios.get(`https://localhost:7292/api/NannyResumes/GetNannyResume/${id}`)
                                .then(response => {
                                    this.resume = response.data;
                                    $('#nannyResumesModal').modal('show'); // 打開詳細資訊視窗
                                })
                                .catch(error => {
                                    console.error("Error fetching resume details:", error);
                                });
                        },

                        checkForm: function () {
                            let forms = document.querySelectorAll('.needs-validation');
                            Array.prototype.slice.call(forms)
                                .forEach(function (form) {
                                    form.addEventListener('submit', function (event) {
                                        if (!form.checkValidity()) {
                                            event.preventDefault();
                                            event.stopPropagation();
                                        } else {
                                            this.create(event);
                                        }
                                        form.classList.add('was-validated');
                                    }, false);
                                });
                        },
                        onFileChange: function (previewTarget, fileVariable, event) {
                            const fileInput = event.target;
                            if (fileInput.files && fileInput.files[0]) {
                                const file = fileInput.files[0];
                                this[fileVariable] = file;
                                const reader = new FileReader();
                                reader.onload = (e) => {
                                    this[previewTarget] = e.target.result;
                                };
                                reader.readAsDataURL(file);
                            }
                        },
                        getNannyResumes: function () {
                            let_this = this;
                            axios.get('@Utility.SD.localHost_API/api/NannyResumes/GetFullinformation', { headers })
                                .then(result => {
                                    //console.log(result.data); // 確認資料結構
                                    let_this.resumes = result.data;
                                })
                                .catch(err => {
                                    console.error(err);
                                });
                        },
                        getPhotoUrl(photo) {
                            return photo != null ? `https://localhost:7000/NannnyAndPerant/nannyreume/${photo}` : `https://localhost:7000/image/noimage.jpg`;
                        },

                        enter(nannyAccountUserAccount) {
                            sessionStorage.setItem("nannyAccountUserAccount", nannyAccountUserAccount);
                            window.location.href = `https://localhost:7231/Machplateform/Home/NannyApply`;
                        },
                    },

                    mounted: function () {

                        let _this = this;
                        //this.getNannyResumes();
                        _this.getNannyResumes();
                    }
                });

                apps.mount('#nannyIndex');
            </script>
        }
