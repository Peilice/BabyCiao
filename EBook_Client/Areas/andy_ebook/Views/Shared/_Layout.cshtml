
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BabyCiao_Client</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/andy_style.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BabyCiao_Client.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <style>
        body {
            background-image: url('/images/giftly.png');
        }
        
        
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light border-bottom  header_div1">
            <div class="container-fluid" id="app00">
                <figure class="logo">
                   @*  <img class="imgLogo" src="~/images/logo.png" alt=""> *@
                    <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index"><img src="~/images/babyciao文字圖.png" width="200" /></a>
                </figure>
                @* <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">BabyCiao</a> *@
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 header_ul">
                        <li class="nav-item header_li4">
                            <a class="nav-link text-dark" asp-area="andy_ebook" asp-controller="Home" asp-action="Index">電子聯絡簿</a>
                        </li>
                        
                        <li class="nav-item header_li4">
                            <a class="nav-link text-dark" asp-area="andy_ebook" asp-controller="Home" asp-action="MatchEbook">授權聯絡簿</a>
                        </li>
                        <template v-if="isNanny==true" >
                            <li class="nav-item header_li4" style="background-color:hotpink">
                                <a class="nav-link text-dark" asp-area="andy_ebook" asp-controller="Home" asp-action="QRcode">接送QRcode</a>
                            </li>
                        <li class="nav-item header_li4" style="background-color:hotpink">
                            <a class="nav-link text-dark" asp-area="andy_ebook" asp-controller="Home" asp-action="NannyArea">托育專區</a>
                        </li>
                        </template>
                    </ul>
                    <partial name="_LoginPartial_self" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container-xxl">
        <div class="row">
            <main role="main" class="pb-1">
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="border-top footer text-muted bottom-0" style="position:relative">
        <img class="img6" src="~/images/p6.png" alt="">
        <img class="img7" src="~/images/p7.png" alt="">
        <div class="container p1">
            2024 - BabyCiao 
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://unpkg.com/vue@3.4.31/dist/vue.global.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/axios/1.7.2/axios.min.js" integrity="sha512-JSCFHhKDilTRRXe9ak/FJ28dcpOJxzQaCd3Xg8MyF6XFjODhy/YMCM8HW0TFDckNHWUewW+kfvhin43hKtJxAw==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://code.jquery.com/jquery-3.3.1.min.js"></script>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <script src="https://unpkg.com/gijgo@1.9.14/js/gijgo.min.js" type="text/javascript"></script>
    <link href="https://unpkg.com/gijgo@1.9.14/css/gijgo.min.css" rel="stylesheet" type="text/css" />
    <script src="https://unpkg.com/gijgo@1.9.14/js/messages/messages.zh-tw.js" type="text/javascript"></script>
    <script>
        const useToken = localStorage.getItem("token");
        const headers = {
            'Authorization': `Bearer ${useToken}`,
        };
        let username = sessionStorage.getItem("username");
        sessionStorage.removeItem('target');
        if (username == null) { 
            window.location.href = `@Utility.SD.localHost_Client/Home/Login`
        }
       

        var vueApp_app00 = {
            data() {
                return {
                    isNanny: false,
                    u_name: "",
                    islogin: false,
                };
            },
            mounted: async function () {
                let _this = this;
                _this.reflesh();
                _this.checkNanny();
                
            },
            methods: {
                reflesh: function () {
                    let _this = this;
                    if (username != null) {
                        _this.islogin = true;
                        _this.u_name = username;
                    }
                },
                checkNanny: async function () {
                    let _this = this;
                    axios.get(`@Utility.SD.localHost_API/api/Andy_NannyMatch/CheckNanny`, {
                        headers
                    }).then(result => {
                        //alert(result.data);
                        _this.isNanny = result.data;

                    }).catch(err => { alert(err) });
                },
            },

        }
        var app_app00 = Vue.createApp(vueApp_app00).mount('#app00')

        $(function () {
            $('#logoutForm').on('click', function (e) {
                e.preventDefault();
                Swal.fire({
                    title: "提示!",
                    text: "您確定的要登出?",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#3085d6",
                    cancelButtonColor: "#d33",
                    confirmButtonText: "是的,確定登出!"
                }).then((result) => {
                    if (result.isConfirmed) {
                        Swal.fire({
                            title: "登出成功!",
                            text: "歡迎再次蒞臨!",
                            icon: "success",
                            showConfirmButton: false,
                            timer: 1500
                        }).then((result) => {
                            sessionStorage.removeItem("username");
                            localStorage.removeItem("username");
                            window.location.href = `@Utility.SD.localHost_Client/Home/Index`
                        });
                    }
                });

            })
        })
        
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

