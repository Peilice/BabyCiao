@section Styles {
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>常見問題</title>
    
    <style>
        .main_1 {
            position: relative;
            width: 100%;
            height: 400px;
            overflow: hidden;
        }

        .image-container_1 {
            position: relative;
            width: 100%;
            height: 400px;
        }

        .module-image_1 {
            width: 100%;
            height: 400px;
            object-fit: cover;
            opacity: 0.5; /* 使圖片刷淡 */
        }

        .title {
            position: absolute;
            top: 50%;
            left: 10%;
            transform: translateY(-50%);
            color: white;
            font-size: 3em;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5)
        }
    </style>
}
<div>
    

    
<!-- Header Start -->
<div class="main_1">
    <section class="module_1">
        <div class="image-container_1">
            <img src="~/style/img/fqa2.jpg" class="module-image_1" />
            <h1 class="title">聯絡我們</h1>
        </div>
    </section>
</div>
<!-- Header End -->

<!-- Contact Start -->
<div class="container-fluid bg-light py-5 " id="newAPP">
    <div class="container py-5">
        <div class="contact p-5">
            <div class="row g-4">
                <div class="col-xl-5">
                    <h1 class="mb-4">請填寫表單</h1>
                    <form v-on:submit.prevent="submitForm">
                        <div class="row gx-4 gy-3">
                            <div class="col-xl-6">
                                <input type="text" class="form-control bg-white border-0 py-3 px-4" placeholder="帳號" v-model="customerService.accountUserAccount">
                            </div>
                            <div class="col-xl-6">
                                <input type="email" class="form-control bg-white border-0 py-3 px-4" placeholder="E-mail" v-model="customerService.email">
                            </div>
                            <div class="col-xl-6">
                                <input type="text" class="form-control bg-white border-0 py-3 px-4" placeholder="連絡電話" v-model="customerService.phone">
                            </div>
                            <div class="col-xl-6">
                                <input type="text" class="form-control bg-white border-0 py-3 px-4" placeholder="主題" v-model="customerService.title">
                            </div>
                            <div class="col-12">
                                <textarea class="form-control bg-white border-0 py-3 px-4" rows="7" cols="10" placeholder="內容" v-model="customerService.context"></textarea>
                            </div>
                            <div class="col-12">
                                <button class="btn-hover-bg btn btn-primary w-100 py-3 px-5" type="submit">送出</button>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="col-xl-7">
                    <div>
                        <div class="row g-4">
                            <div class="col-lg-4">
                                <div class="bg-white p-4">
                                    <i class="fas fa-map-marker-alt fa-2x text-primary mb-2"></i>
                                    <h4>地址</h4>
                                    <p class="mb-0">高雄市新興區</p>
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <div class="bg-white p-4">
                                    <i class="fas fa-envelope fa-2x text-primary mb-2"></i>
                                    <h4>E-mail</h4>
                                    <p class="mb-0">info@example.com</p>
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <div class="bg-white p-4">
                                    <i class="fa fa-phone fa-2x text-primary mb-2"></i>
                                    <h4>電話</h4>
                                    <p class="mb-0">(+886) 7 123 1123</p>
                                </div>
                            </div>
                            <div class="col-lg-12">
                                <iframe class="w-100" style="height: 412px; margin-bottom: -6px;" src="https://www.google.com/maps/embed?pb=!1m14!1m12!1m3!1d674.7425724581295!2d120.29302336746046!3d22.627996272774645!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!5e0!3m2!1szh-TW!2stw!4v1717867806284!5m2!1szh-TW!2stw"
                                        loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Contact End -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/vue@3.2.0/dist/vue.global.prod.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/axios/1.7.2/axios.min.js" integrity="sha512-JSCFHhKDilTRRXe9ak/FJ28dcpOJxzQaCd3Xg8MyF6XFjODhy/YMCM8HW0TFDckNHWUewW+kfvhin43hKtJxAw==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>

    <script>
        const { createApp } = Vue;

        createApp({
            data() {
                return {
                    customerService: {
                        userName: '',
                        phone: '',
                        email: '',
                        title: '',
                        context: '',
                        type: '',
                        statement: '',
                        accountUserAccount: ''
                    }
                };
            },
            methods: {
                loadUserData() {
                    // 從 sessionStorage 取得 account
                    const account = sessionStorage.getItem('username');

                    if (!account) {
                        alert('請先登錄');
                        return;
                    }

                    this.customerService.accountUserAccount = account;

                    // 使用你的 API 來取得個人資料
                    axios.get(`https://localhost:7292/api/UserInformation/${account}`)

                        .then(response => {
                            // 將取得的資料填入表單
                            this.customerService.email = response.data.email;
                            this.customerService.phone = response.data.phone;
                        })
                        .catch(error => {
                            console.error('無法取得個人資料', error);
                            alert('無法取得個人資料，請稍後再試');
                        });
                },
                submitForm() {
                    // 從 sessionStorage 取得 token
                    const token = sessionStorage.getItem('token');

                    if (!token) {
                        alert('請先登錄');
                        return;
                    }

                    // 已經在 loadUserData 方法中填入了 account 字段
                    axios.post('https://localhost:7292/api/CustomerService', this.customerService, {
                        headers: { Authorization: `Bearer ${token}` }
                    })
                        .then(response => {
                            console.log('表單提交成功', response.data);
                            alert('表單提交成功');
                            this.resetForm();
                        })
                        .catch(error => {
                            console.error('表單提交失敗', error);
                            alert('表單提交失敗，請稍後再試');
                        });
                },
                resetForm() {
                    this.customerService = {
                        userName: '',
                        phone: '',
                        email: '',
                        title: '',
                        context: '',
                        type: '',
                        statement: '',
                        accountUserAccount: ''
                    };
                }
            },
            mounted() {
                this.loadUserData();
            }
        }).mount('#newAPP');
    </script>


   
