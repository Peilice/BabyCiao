@section Styles{
    <style>
       

        html {
            height: 100%
        }

        h2 {
            color: #2F8D46;
        }

        #form {
            text-align: center;
            position: relative;
            margin-top: 20px
        }

            #form fieldset {
                background: white;
                border: 0 none;
                border-radius: 0.5rem;
                box-sizing: border-box;
                width: 100%;
                margin: 0;
                padding-bottom: 20px;
                position: relative
            }

        .finish {
            text-align: center
        }

        #form fieldset:not(:first-of-type) {
            display: none
        }

        #form .previous-step, .next-step {
            width: 100px;
            font-weight: bold;
            color: white;
            border: 0 none;
            border-radius: 0px;
            cursor: pointer;
            padding: 10px 5px;
            margin: 10px 5px 10px 0px;
            float: right
        }

        .form, .previous-step {
            background: #616161;
        }

        .form, .next-step {
            background: #2F8D46;
        }

        #form .previous-step:hover,
        #form .previous-step:focus {
            background-color: #000000
        }

        #form .next-step:hover,
        #form .next-step:focus {
            background-color: #2F8D46
        }

        .text {
            color: #2F8D46;
            font-weight: normal
        }

        #progressbar {
            margin-bottom: 30px;
            overflow: hidden;
            color: lightgrey
        }

            #progressbar .active {
                color: #2F8D46
            }

            #progressbar li {
                list-style-type: none;
                font-size: 15px;
                width: 25%;
                float: left;
                position: relative;
                font-weight: 400
            }

            #progressbar #step1:before {
                content: "1"
            }

            #progressbar #step2:before {
                content: "2"
            }

            #progressbar #step3:before {
                content: "3"
            }

            #progressbar #step4:before {
                content: "4"
            }

            #progressbar li:before {
                width: 50px;
                height: 50px;
                line-height: 45px;
                display: block;
                font-size: 20px;
                color: #ffffff;
                background: lightgray;
                border-radius: 50%;
                margin: 0 auto 10px auto;
                padding: 2px
            }

            #progressbar li:after {
                content: '';
                width: 100%;
                height: 2px;
                background: lightgray;
                position: absolute;
                left: 0;
                top: 25px;
                z-index: -1
            }

            #progressbar li.active:before,
            #progressbar li.active:after {
                background: #2F8D46
            }

        .progress {
            height: 20px
        }

        .progress-bar {
            background-color: #2F8D46
        }
    </style>
}

<div class="container" id="registerForm">
    <div class="row">
        <div class="col-12 text-center ">
            <div class="px-0 pb-0 mb-3">
                <div id="form" class="mt-0 " >
                    <ul id="progressbar" class="mb-0  d-flex justify-content-center">
                        <li class="active" id="step1">
                            <strong>填寫帳號/密碼</strong>
                        </li>
                        <li id="step2"><strong>填寫基本資料</strong></li>
                        <li id="step3"><strong>註冊成功</strong></li>
                    </ul>
                    <br>
                    <fieldset>
                        <div class="container">
                            <div class="row">
                                <form class="needs-validation" novalidate>
                                    
                                <div class="col-4 offset-4 " >
                                    <h4>註冊新帳號</h4>
                                    <hr />
                                    <div class="form-floating mb-3">
                                        <input class="form-control" autocomplete="username" aria-required="true" placeholder="帳號" v-model="account" v-bind:disabled="ischeck" required />
                                        <label>帳號</label>
                                        <span class="text-danger"></span>
                                    </div>
                                    <div class="form-floating mb-3">
                                        <input type="password" class="form-control" aria-required="true" placeholder="password" v-model="password1" v-bind:disabled="ischeck" required />
                                        <label>密碼</label>
                                        <span class="text-danger"></span>
                                    </div>
                                    <div class="form-floating mb-3">
                                        <input type="password" class="form-control" aria-required="true" placeholder="密碼" v-model="password2" v-bind:disabled="ischeck" required />
                                        <label>密碼確認</label>
                                        <span class="text-danger"></span>
                                    </div>
                                    <div class="mb-3">
                                        <template v-if="ischeck==true">
                                            <span class=" mb-3">{{statue}}</span>
                                        </template>
                                        <template v-else>
                                            <span class="text-danger mb-3">{{statue}}</span>
                                        </template>
                                    </div>
                                    <button class=" w-100 btn btn-lg btn-primary" v-on:click="checkForm">送出</button>

                                </div>
                                </form>
                            </div>
                        </div>
                        <input type="button" name="next-step"
                               class="next-step btn" value="下一步" v-bind:disabled="step1" />
                    </fieldset>
                    <fieldset>
                        <h2>填寫基本資料</h2>
                        <div class="container">
                            <form class="needs-validation" novalidate>
                            <div class="row">
                                
                                <div class="col-4">
                                    <div class="form-floating mb-3">
                                        <input type="text" class="form-control" id="Account_User" v-model="account" readonly>
                                        <label for="Account_User">帳號</label>
                                    </div>
                                    <div class="form-floating mb-3">
                                            <input type="email" class="form-control" id="email" v-model="email" v-bind:disabled="ischeck2" required>
                                            <label for="email">Email信箱</label>
                                    </div>
                                    <div class="form-floating mb-3">
                                            <input type="text" class="form-control" id="Phone" v-model="phone" v-bind:disabled="ischeck2" required>
                                            <label for="Phone">電話</label>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="form-floating mb-3">
                                            <input type="text" class="form-control" id="UserFirstName" v-model="userFirstName" v-bind:disabled="ischeck2" required>
                                            <label for="UserFirstName">姓氏</label>
                                    </div>
                                    <div class="form-floating mb-3">
                                            <input type="text" class="form-control" id="UserLastName" v-model="userLastName" v-bind:disabled="ischeck2" required>
                                            <label for="UserLastName">名子</label>
                                    </div>
                                    <div class="form-floating mb-3">
                                            <input type="text" class="form-control" id="Nickname" v-model="nickname" v-bind:disabled="ischeck2" required>
                                            <label for="Nickname">暱稱</label>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="form-floating mb-3">
                                            <input type="text" class="form-control" id="Address" v-model="address" v-bind:disabled="ischeck2" required>
                                            <label for="Address">地址</label>
                                    </div>
                                    <div class="form-floating mb-3">
                                            <input type="date" class="form-control" id="Birthday" v-model="birthday" v-bind:disabled="ischeck2" required>
                                            <label for="Birthday">生日</label>
                                    </div>
                                    <div class="form-floating mb-3">
                                            <select class="form-control" id="Gender" v-model="gender" v-bind:disabled="ischeck2" required>
                                                <option value ="" selected disabled>請選擇</option>
                                                <option value="0">女</option>
                                                <option value="1">男</option>
                                            </select>

                                            <label for="Gender">性別</label>
                                    </div>
                                </div>
                                <hr />
                                    <div class="d-flex justify-content-center">
                                        <button class=" w-25 btn btn-lg btn-primary" v-on:click="checkForm" v-bind:disabled="ischeck2">確認</button>
                                </div>
                            </div>
                            </form>
                        </div>
                        <input type="button" name="next-step"
                               class="next-step btn" value="下一步" v-bind:disabled="step2" />
                        <input type="button" name="previous-step"
                               class="previous-step"
                               value="上一步" />
                    </fieldset>
                    <fieldset>
                        <div class="finish">
                            <h2 class="text text-center">
                                <strong>註冊成功</strong>
                            </h2>
                        </div>
                    </fieldset>
                </div>



            </div>
        </div>
        
    </div>
    
</div>



@section Scripts{
    <script>
        var vueApp_regiser = {
            data() {
                return {
                    u_name: "",
                    islogin: false,
                    statue:"",
                    ischeck:false,
                    ischeck2:false,
                    password1:"",
                    password2:"",
                    account:"",
                    step1:true,
                    step2: true,
                    isCreate:false,
                    enter: false,
                    //會員資料用
                    
                    userFirstName: "",
                    userLastName: "",
                    phone: "",
                    address: "",
                    gender: 0,
                    email: "",
                    nickname: "",
                    birthday: "",
                    
                };
            },
            mounted: function () {
                let _this = this;
                //_this.reflesh();
            },
            methods: {
                register: function () {
                    let _this = this;
                    var request = {};
                    request.accountUser = _this.account;
                    request.userFirstName = _this.userFirstName;
                    request.userLastName = _this.userLastName;
                    request.phone = _this.phone;
                    request.address = _this.address;
                    request.gender = _this.gender;
                    request.email = _this.email;
                    request.nickname = _this.nickname;
                    request.birthday = _this.birthday;
                    request.password = _this.password2;
                    axios.post(`@Utility.SD.localHost_API/api/Andy_JWT_Login/Register_step2`, request).then(result => {
                        //alert(result.data)
                        Swal.fire({
                            position: "center",
                            icon: "success",
                            title: "註冊成功",
                            showConfirmButton: false,
                            timer: 1500
                        }).then(s => {
                            _this.ischeck2 = true;
                            _this.step2 = false;
                        });
                    }).catch(err => { alert(err) });
                },
                check: function () {
                    let _this = this;
                    _this.ischeck = false;
                    var request = {};
                    request.account = _this.account;
                    request.password = _this.password1;
                    request.confirmPassword = _this.password2;

                    axios.post(`@Utility.SD.localHost_API/api/Andy_JWT_Login/Register_step1`, request).then(result => {
                        //alert(result.data)
                        _this.statue = result.data;
                        if (_this.statue == "此帳號可使用") {
                            _this.ischeck = true;
                            _this.step1 = false;
                        }


                    }).catch(err => {alert(err) });
                },
                checkForm: function () {
                    let _this = this;
                    _this.isCreate = true;
                    let forms = document.querySelectorAll('.needs-validation')
                    //alert(forms)
                    Array.prototype.slice.call(forms)
                        .forEach(function (form) {
                            form.addEventListener('submit', function (event) {
                                if (!form.checkValidity()) {
                                    event.preventDefault()
                                    event.stopPropagation()
                                } else {
                                    if (_this.isCreate) {
                                        event.preventDefault()
                                        event.stopPropagation()
                                        //alert('create!')
                                        _this.isCreate = false;
                                        if (_this.ischeck != true) {
                                            _this.check(event);

                                        } else if (_this.ischeck2 != true) {
                                            _this.register(event);
                                        }
                                        
                                    } else {
                                        event.preventDefault()
                                        event.stopPropagation()
                                    }
                                }
                                form.classList.add('was-validated')
                            }, false)
                        })

                },

            },
        }
        var app_regiser = Vue.createApp(vueApp_regiser).mount('#registerForm')

        $(document).ready(function () {
            var currentGfgStep, nextGfgStep, previousGfgStep;
            var opacity;
            var current = 1;
            var steps = $("fieldset").length;

            setProgressBar(current);

            $(".next-step").click(function () {

                currentGfgStep = $(this).parent();
                nextGfgStep = $(this).parent().next();

                $("#progressbar li").eq($("fieldset")
                    .index(nextGfgStep)).addClass("active");

                nextGfgStep.show();
                currentGfgStep.animate({ opacity: 0 }, {
                    step: function (now) {
                        opacity = 1 - now;

                        currentGfgStep.css({
                            'display': 'none',
                            'position': 'relative'
                        });
                        nextGfgStep.css({ 'opacity': opacity });
                    },
                    duration: 500
                });
                setProgressBar(++current);
            });

            $(".previous-step").click(function () {

                currentGfgStep = $(this).parent();
                previousGfgStep = $(this).parent().prev();

                $("#progressbar li").eq($("fieldset")
                    .index(currentGfgStep)).removeClass("active");

                previousGfgStep.show();

                currentGfgStep.animate({ opacity: 0 }, {
                    step: function (now) {
                        opacity = 1 - now;

                        currentGfgStep.css({
                            'display': 'none',
                            'position': 'relative'
                        });
                        previousGfgStep.css({ 'opacity': opacity });
                    },
                    duration: 500
                });
                setProgressBar(--current);
            });

            function setProgressBar(currentStep) {
                var percent = parseFloat(100 / steps) * current;
                percent = percent.toFixed();
                $(".progress-bar")
                    .css("width", percent + "%")
            }

            // $(".submit").click(function () {
            //     return false;
            // })
        });
    </script>
}