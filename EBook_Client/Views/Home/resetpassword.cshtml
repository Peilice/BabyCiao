@{
    Layout = "_Layout";
    ViewData["Title"] = "重設密碼";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header text-center">
                    <h2>重設密碼</h2>
                </div>
                <div class="card-body">
                    <form id="resetPasswordForm">
                        <div class="mb-3">
                            <label for="newPassword" class="form-label">新密碼</label>
                            <input type="password" id="newPassword" name="newPassword" class="form-control" required autocomplete="off" />
                        </div>
                        <div class="mb-3">
                            <label for="confirmPassword" class="form-label">確認新密碼</label>
                            <input type="password" id="confirmPassword" name="confirmPassword" class="form-control" required autocomplete="off" />
                        </div>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">重設密碼</button>
                        </div>
                        <div class="mt-3 text-center">
                            <a asp-action="Login">返回登入</a>
                        </div>
                    </form>
                    <div id="message" class="mt-3"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('resetPasswordForm').addEventListener('submit', async function (event) {
            event.preventDefault();

            const newPassword = document.getElementById('newPassword').value;
            const confirmPassword = document.getElementById('confirmPassword').value;
            const messageDiv = document.getElementById('message');

            if (newPassword !== confirmPassword) {
                messageDiv.textContent = '密碼不一致，請重新輸入';
                messageDiv.className = 'alert alert-danger';
                return;
            }

            const urlParams = new URLSearchParams(window.location.search);
            const token = urlParams.get('token');

            if (!token) {
                messageDiv.textContent = '無效的驗證令牌';
                messageDiv.className = 'alert alert-danger';
                return;
            }

            try {
                const response = await fetch('https://localhost:7292/api/UserAccount/resetPassword', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ token, newPassword })
                });

                const data = await response.json();

                if (response.ok) {
                    messageDiv.textContent = data.message;
                    messageDiv.className = 'alert alert-success';
                    setTimeout(() => {
                        window.location.href = "https://localhost:7231/";
                    }, 3000);
                } else {
                    messageDiv.textContent = data.message;
                    messageDiv.className = 'alert alert-danger';
                    console.error('重設密碼失敗', data);
                }
            } catch (error) {
                messageDiv.textContent = '重設密碼失敗，請稍後再試';
                messageDiv.className = 'alert alert-danger';
                console.error('重設密碼失敗', error);
            }
        });
    </script>
}
