@section Styles {
    <style>
        #myRes li:nth-child(2n) {
            background-color: #F5F5F5
        }

        #myArti li:nth-child(2n) {
            background-color: #F5F5F5
        }
    </style>
}


<div id="App">
    <!-- Breadcrumb -->
    <div class="container mb-3">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">社群</li>
                <li class="breadcrumb-item"><a href="https://localhost:7231/Platform">討論區</a></li>
                <li class="breadcrumb-item">管理我的文章</li>
            </ol>
        </nav>
    </div>

    <div class="container d-flex justify-content-between">
        <!--側欄-->
        <div class="col-md-2">
            <div class="d-grid gap-3">
                <button class="btn btn-info" type="button" v-on:click="getmyArti">我的貼文</button>
                <button class="btn btn-info" type="button" v-on:click="getmyRes">我的回應</button>
                @* <button class="btn btn-info" type="button">收藏的帳號</button> *@
            </div>
        </div>
        <!--主要內容-->
        <div class="col-md-9">
            <div>
                <h2 class="fw-bold">管理我的文章</i></h2>
            </div>
            <!--我的文章-->
            <div v-show="isArti">
                <h4 class="border-bottom mb-3">我的貼文</h4>
                <ul class="list-group" id="myArti">
                    <li class="list-group-item d-flex justify-content-between" v-for="item in myArti">
                        <div>
                            <h5>{{item.postTitle}}</h5>
                            <h5>《{{item.postType}}》</h5>
                            <h5>發布時間：{{item.postModifiedTime}}</h5>
                            <h5>留言回應數：{{item.responseCount}}</h5>
                        </div>
                        <div class="d-flex align-items-center">
                            <button class="btn btn-secondary" type="button" v-on:click="delArti(item.articleID)">刪除文章</button>
                        </div>
                    </li>
                </ul>
            </div>

                <!--我的回應-->
                <div v-show="isResponse">
                <h4 class="border-bottom mb-3">我的回應</h4>
                    <ul class="list-group" id="myRes">
                    <li class="list-group-item d-flex justify-content-between" v-for="item in myRes">
                            <div>
                                <div>
                                    <h5>《{{item.postType}}》{{item.postTitle}}</h5>
                                </div>
                                <div>
                                    <p>{{item.responseAccount}}</p>
                                    <p>{{item.responseContent}}</p>
                                </div>
                            </div>
                            <div class="d-flex align-items-center">
                            <button class="btn btn-secondary" type="button" v-on:click="delRes(item.responseID)">刪除回應</button>
                            </div>
                        </li>
                    </ul>
                </div>

                <!--收藏的帳號-->
                <div v-show="isFavorite">
                    <h2>收藏的帳號</h2>
                    <ul class="list-group">
                        <li class="list-group-item">
                            <div>
                                <h4 class="text-center">圖片</h4>

                            </div>
                            <div>
                                <h4 class="text-center">帳號</h4>

                            </div>
                            <button class="btn btn-secondary" type="button">刪除收藏</button>
                        </li>
                    </ul>
                </div>
        </div>
    </div>

</div>


<!-- axios -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/axios/1.7.2/axios.min.js"
        integrity="sha512-JSCFHhKDilTRRXe9ak/FJ28dcpOJxzQaCd3Xg8MyF6XFjODhy/YMCM8HW0TFDckNHWUewW+kfvhin43hKtJxAw=="
        crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<script>
    var vueApp = {
        data() {
            return {
                userAccount:sessionStorage.getItem("username"),
                //userAccount: "user5",
                myArti:[],
                myRes:[],

                //控制出現頁面
                isFavorite:false,
                isArti:false,
                isResponse:false,

            };
        },
        methods: {
            getmyArti: function () {
                let _this = this;
                _this.isArti = true;
                _this.isResponse = false;

                account = _this.userAccount;
                axios.get(`https://localhost:7292/api/Platform/getMyArti/${account}`)
                .then(result=>{
                    _this.myArti = result.data;
                })
            },
            getmyRes:function(){
                let _this = this;
                _this.isArti = false;
                _this.isResponse = true;

                account = _this.userAccount;
                axios.get(`https://localhost:7292/api/Platform/getMyRes/${account}`)
                    .then(result => {
                        _this.myRes = result.data;
                    })
            },
            delRes:function(id){
                let _this = this;
                //再次確認是否刪除
                Swal.fire({
                    title: "是否確定刪除?",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#3085d6",
                    cancelButtonColor: "#d33",
                    confirmButtonText: "確認刪除留言!"
                }).then((result) => {
                    if (result.isConfirmed) {
                        axios.delete(`https://localhost:7292/api/Platform/delResponse/${id}`)
                            .then(result => {
                                Swal.fire({
                                    title: "您的留言已取消!",
                                    icon: "success"
                                })
                                    .then(result => {
                                        _this.getmyRes();
                                    })
                            })

                    }
                });
            },
            delArti:function(id){
                let _this = this;

                //再次確認是否刪除
                Swal.fire({
                    title: "是否確定刪除?",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#3085d6",
                    cancelButtonColor: "#d33",
                    confirmButtonText: "確認刪除文章!"
                }).then((result) => {
                    if (result.isConfirmed) {
                        axios.delete(`https://localhost:7292/api/Platform/delArticle/${id}`)
                            .then(result => {
                                Swal.fire({
                                    title: "您的文章已刪除!",
                                    icon: "success"
                                })
                                    .then(result => {
                                        _this.getmyArti();
                                    })
                            })

                    }
                });
            },

        },
        mounted:function(){
            let _this = this;
            _this.getmyArti();
        }
    }
    var app = Vue.createApp(vueApp).mount("#App");
</script>
