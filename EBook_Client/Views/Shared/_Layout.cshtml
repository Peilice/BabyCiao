
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BabyCiao_Client</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BabyCiao_Client.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Vue -->
    <script src="https://unpkg.com/vue@latest"></script>
    @await RenderSectionAsync("Styles", required: false)

    <style>
        body{
            background-image: url('/images/bg2.jpg');
            font-family: '華康采風體W3', serif;
            font-size:20px;
        }

        #nav {
            background-color: #8babc6;
            /* opacity: .8; */
        }

        /* #main {
            background-image: url(/images/backgroundimg.jpg);
        } */
    </style>

</head>
<body>
    <header id="nav">
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid" id="app00">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index"><img src="~/images/babyciao文字圖.png" width="200" /></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="active nav-link" asp-area="" asp-controller="Home" asp-action="About">關於我們</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link text-dark dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">媒合平台</a>
                            <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                                <li><a class="active nav-link" asp-area="Machplateform" asp-controller="Home" asp-action="Index">一同巧育</a></li>
                                <li><a class="active nav-link" asp-area="Machplateform" asp-controller="Home" asp-action="NannyApply">加入我們</a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="@Utility.SD.localHost_Backstage/Home/Index">管理後台</a>
                        </li>
                        <li class="nav-item">
                            <a id="e_book" class="nav-link text-dark" asp-area="andy_ebook" asp-controller="Home" asp-action="Index">電子聯絡簿</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link text-dark dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">社群</a>
                            <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="LilyGArea" asp-controller="Home" asp-action="Index">團購商品</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="LilySArea" asp-controller="Home" asp-action="Index">二手物品</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Competitions" asp-action="Index">線上投票活動</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Platform" asp-action="Index">討論區</a>
                                </li>
                            </ul>
                        </li>
                        
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Contact">聯絡我們</a>
                        </li>

                    </ul>
                    <partial name="_LoginPartial_self" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container" id="main">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    @* 互動式視窗 *@
    <div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content" id="app">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">登入</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="container">
                        <div class="row">
                            <div class=" mb-3 ">
                                <label class="form-label" for="">帳號</label>
                                <input class="form-control" type="text" @@keyup="enable" v-model="username">
                            </div>
                            <div class=" mb-3 ">
                                <label class="form-label" for="">密碼</label>
                                <input class="form-control" type="password" @@keyup="enable" v-model="password">
                            </div>
                            <div class=" mb-3">
                                
                            </div>
                        </div>

                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                    <button class="btn btn-primary" v-bind:disabled="disableCheck" @@click="submit">登入</button>
                </div>
            </div>
        </div>
    </div>

    <footer class="border-top footer text-muted" style="position:relative">
        <div class="container">
            &copy; 2024 - test2 - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer> 
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://unpkg.com/vue@3.4.31/dist/vue.global.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/axios/1.7.2/axios.min.js" integrity="sha512-JSCFHhKDilTRRXe9ak/FJ28dcpOJxzQaCd3Xg8MyF6XFjODhy/YMCM8HW0TFDckNHWUewW+kfvhin43hKtJxAw==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        let username = sessionStorage.getItem("username");

        var vueApp = {
            data() {
                return {
                    u_name: "",
                    islogin: false,
                };
            },
            mounted: function () {
                let _this = this;
                _this.reflesh();
            },
            methods: {
                reflesh: function () {
                    let _this = this;
                    if (username != null) {
                        _this.islogin = true;
                    }
                    _this.u_name = username;
                },
                
            },

        }
        var app = Vue.createApp(vueApp).mount('#loginApp')
        var vueApp_login = {
            data() {
                return {
                    username: "",
                    password: "",
                    disableCheck: true,
                    baseAddress_API: "@Utility.SD.localHost_API",
                    baseAddress_client: "@Utility.SD.localHost_Client",
                }
            },
            mounted: function () {
                let _this = this;
            },
            methods: {
                enable: function () {
                    this.disableCheck = this.password.length <= 0 || this.username.length <= 0

                },
                submit: function () {
                    // alert("submit");
                    let _this = this;
                    var request = {};
                    request.name = _this.username;
                    request.password = _this.password;

                    axios.post(`${_this.baseAddress_API}/api/Andy_JWT_Login`, request).then(response => {
                        const token = response.data;
                        const data1 = { Token: token };
                        localStorage.setItem("token", data1.Token);

                        Swal.fire({
                            position: "center",
                            icon: "success",
                            title: "登入成功",
                            showConfirmButton: false,
                            timer: 1500
                        }).then(s => {
                            const useToken = localStorage.getItem("token");
                            const headers = {
                                'Authorization': `Bearer ${useToken}`,
                            };

                            axios.get(`${_this.baseAddress_API}/api/Andy_JWT_Login`, {
                                headers
                            }).then(result => {
                                // alert(result.data)
                                const username = result.data;
                                const data2 = { Name: username };
                                sessionStorage.setItem("username", data2.Name);
                                // $('#username').text(`${result.data} ,你好!`);//實驗
                                var target = sessionStorage.getItem("target");
                                if (target != null) {
                                    window.location.href = `${target}`;
                                } else {
                                    window.location.href = `${_this.baseAddress_client}/Home/Index`;
                                }
                            }).catch(err => {
                                alert(err);
                            })
                        });

                    }).catch(err => {
                        alert(err);
                    })
                },
            }
        };
        var app01 = Vue.createApp(vueApp_login).mount("#app");
        $(function () {
            //登出動畫與操作
            $('#logoutForm').on('click', function (e) {
                e.preventDefault();
                Swal.fire({
                    title: "提示!",
                    text: "您確定要登出?",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#3085d6",
                    cancelButtonColor: "#d33",
                    confirmButtonText: "是的,確定登出!"
                }).then((result) => {
                    if (result.isConfirmed) {
                        Swal.fire({
                            title: "登出成功!",
                            text: "歡迎再次蒞臨!",
                            icon: "success",
                            showConfirmButton: false,
                            timer: 1500
                        }).then((result) => {
                            sessionStorage.removeItem("username");
                            localStorage.removeItem("token");
                            window.location.href = `@Utility.SD.localHost_Client/Home/Index`
                        });
                    }
                });

            })
            $('#e_book').on("click", function (e) {
                if (username != null) {

                } else {
                    e.preventDefault();
                    sessionStorage.setItem("target", "@Utility.SD.localHost_Client/andy_ebook/Home/Index")
                    //window.location.href = "@Utility.SD.localHost_Client/Home/Login";
                    $('#exampleModal').modal('show');
                }
            })
        })

    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>


